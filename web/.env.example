# Template for the frontend's local environment variables.
# Copy to .env.local (git-ignored) and adjust:  cp .env.example .env.local

# Where the browser sends API requests. NEXT_PUBLIC_ variables are baked into the JS bundle
# at build time, so this must never hold a secret, and changing it needs a rebuild.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Neon Auth (server-only: no NEXT_PUBLIC_ prefix, so they never reach the browser bundle).
# Base URL: Neon console -> your branch -> Auth, or `npx neon checkout dev` in infra/neon
# (NEON_AUTH_BASE_URL in infra/neon/.env.local). Use the dev branch locally.
NEON_AUTH_BASE_URL=https://your-endpoint.neonauth.example/neondb/auth
# Signs the session cookies. At least 32 characters; generate with: openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=replace-with-output-of-openssl-rand-base64-32
