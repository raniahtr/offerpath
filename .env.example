# Template for local environment variables.
# Copy to .env (git-ignored) and adjust:  cp .env.example .env
# These defaults are for LOCAL DEV ONLY; hosted environments get their own secrets.

# Read by the Postgres container on first start to create the user + database.
POSTGRES_USER=offerpath
POSTGRES_PASSWORD=offerpath
POSTGRES_DB=offerpath

# How the api connects to the database (used from Phase 1 on).
# Host is "db" = the compose service name, not localhost.
DATABASE_URL=postgresql+psycopg://offerpath:offerpath@db:5432/offerpath

# Separate database for pytest (created by infra/db/init.sql). Tests roll back every change.
TEST_DATABASE_URL=postgresql+psycopg://offerpath:offerpath@db:5432/offerpath_test

# Browser origins allowed to call the API (JSON list). 3000 = Next.js dev server.
CORS_ORIGINS=["http://localhost:3000"]
