# Template for local environment variables.
# Copy to .env (git-ignored) and adjust:  cp .env.example .env
# These defaults are for LOCAL DEV ONLY; hosted environments get their own secrets.

# Read by the Postgres container on first start to create the user + database.
POSTGRES_USER=offerpath
POSTGRES_PASSWORD=offerpath
POSTGRES_DB=offerpath

# How the api connects to the database (used from Phase 1 on).
# Host is "db" = the compose service name, not localhost.
DATABASE_URL=postgresql+psycopg://offerpath:offerpath@db:5432/offerpath

# Separate database for pytest (created by infra/db/init.sql). Tests roll back every change.
TEST_DATABASE_URL=postgresql+psycopg://offerpath:offerpath@db:5432/offerpath_test

# Browser origins allowed to call the API (JSON list). 3000 = Next.js dev server.
CORS_ORIGINS=["http://localhost:3000"]

# Sign-in: the identity provider that issues login tokens (Neon Auth). The API checks each
# token's signature with the provider's PUBLIC keys at AUTH_JWKS_URL, so none of these are
# secrets. Get the values from Neon Console -> your project -> Auth (for your dev branch):
#   AUTH_JWKS_URL = <Neon Auth URL>/.well-known/jwks.json
#   AUTH_ISSUER / AUTH_AUDIENCE = the origin of the Neon Auth URL (scheme + host, no path)
# Until they are set, the API starts but every request except /health is refused (401/503).
AUTH_JWKS_URL=https://your-neon-auth-host.example/.well-known/jwks.json
AUTH_ISSUER=https://your-neon-auth-host.example
AUTH_AUDIENCE=https://your-neon-auth-host.example

# AI features (fit analysis, CV suggestions, cover letters): any OpenAI-compatible chat API.
# Default: Groq free tier. Create a key at https://console.groq.com/keys and turn on
# Zero Data Retention (Settings -> Data Controls), since users' CVs are sent to it.
# Without a key the app works, but AI features answer 503 "AI is not configured".
LLM_API_KEY=
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=openai/gpt-oss-120b
# LLM_REASONING_EFFORT=low
# LLM_DAILY_LIMIT_PER_USER=20
