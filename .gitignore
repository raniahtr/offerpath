# Secrets: real env vars live in .env (copy from .env.example), never committed
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Node / Next.js
node_modules/
.next/
out/

# OS / editors
.DS_Store
.vscode/
.idea/

# Personal context for Claude Code (kept local)
CLAUDE.local.md

# Real CV is personal data; only fake samples (e.g. cv.example.tex) may be committed
resume/*
!resume/.gitkeep
!resume/*.example.*
